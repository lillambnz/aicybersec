# Cloudflare Environment Variables
# Copy this file to .env.local for local development

# Site Configuration
SITE_URL=https://aicybersec.pages.dev
CONTACT_EMAIL=contact@aicybersec.com

# These are bound automatically in Cloudflare Pages
# No need to set them locally - Wrangler handles it
# DB - Cloudflare D1 Database
# KV - Cloudflare KV Namespace
# R2 - Cloudflare R2 Bucket
# AI - Cloudflare Workers AI

# Optional: Analytics
# ANALYTICS_TOKEN=your-analytics-token
